; Engine configuration file.
; Godot 4.x. See docs/TECHNICAL_DESIGN.md section 1 for why each render setting is what it is.

config_version=5

[application]

config/name="A Song of Ice and Fire"
config/description="Top-down pixel-art RPG retelling A Game of Thrones through two original protagonists."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://autoload/game_manager.gd"
SaveSystem="*res://autoload/save_system.gd"
DialogueSystem="*res://autoload/dialogue_system.gd"
QuestSystem="*res://autoload/quest_system.gd"
SceneDirector="*res://autoload/scene_director.gd"
AudioManager="*res://autoload/audio_manager.gd"

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/window_width_override=1536
window/size/window_height_override=864
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[input]

move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
run={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
attack_light={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
block={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":2)]
}
dodge={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
look={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194326)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
anti_aliasing/quality/msaa_2d=0
